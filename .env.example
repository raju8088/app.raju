APP_DOMAIN=app.example.com
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_SECRET_KEY=replace-with-random-secret-at-least-50-characters-long
OMNIDIM_ENCRYPTION_KEY=replace-with-generated-fernet-key
POSTGRES_PASSWORD=replace-with-random-database-password
DATABASE_URL=postgresql://omnidim:replace-with-url-encoded-database-password@db:5432/omnidim
HISTORY_RETENTION_DAYS=30
# Emergency switch: set 1 to stop mutations while allowing read operations.
OMNIDIM_READ_ONLY=0
